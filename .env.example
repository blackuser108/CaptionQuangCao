# Chọn rõ phía server; không fallback. Next đọc các biến này trong prototype/.env.local.
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=replace_with_gemini_developer_api_key
# Online: APP_ORIGIN là một origin HTTPS chính xác. Preview mặc định dùng VERCEL_URL do Vercel cấp.
# APP_ORIGIN=https://your-exact-preview.example

# Giữ cho rollback thủ công: AI_PROVIDER=freellmapi rồi restart server.
FREELLMAPI_BASE_URL=http://127.0.0.1:31415/v1
FREELLMAPI_MODEL=auto
FREELLMAPI_API_KEY=replace_with_local_unified_key

# Next đọc auth riêng từ prototype/.env.local; không dùng secret/service-role.
SUPABASE_URL=https://replace_project_ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
AUTH_SITE_URL=http://127.0.0.1:3000
AUTH_GOOGLE_ENABLED=false
