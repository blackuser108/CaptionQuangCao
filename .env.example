# Server only. Next.js reads prototype/.env.local; never commit actual keys.
AI_PROVIDER=gemini
# auto selects an accessible approved model before one inference; never retries.
GEMINI_MODEL=auto
GEMINI_API_KEY=replace_with_gemini_developer_api_key
# Online requires the exact canonical HTTPS origin, with no trailing slash.
# APP_ORIGIN=https://your-project.vercel.app
FREELLMAPI_BASE_URL=http://127.0.0.1:31415/v1
FREELLMAPI_MODEL=auto
FREELLMAPI_API_KEY=replace_with_local_unified_key
SUPABASE_URL=https://replace_project_ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
AUTH_SITE_URL=http://127.0.0.1:3000
AUTH_GOOGLE_ENABLED=false
