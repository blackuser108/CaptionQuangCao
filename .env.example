# Server only. Root npm scripts load root .env.local; workspace commands read prototype/.env.local.
# Keep actual keys in one ignored file; never commit them or duplicate them unnecessarily.
AI_PROVIDER=gemini
# Prepared configuration; do not activate Production before the deployment decision.
# Deep: at most four total attempts, including errors and the one permitted Gemini -> Groq switch.
CAPTION_PIPELINE=deep
# Google currently redirects this requested ID to Gemini 3.6 Flash. Keep the user's requested ID explicit.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_API_KEY=replace_with_gemini_developer_api_key
GEMINI_FALLBACK=groq
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=replace_with_groq_api_key
# OpenRouter has no active caller; old secrets need not be copied or read.
# Set AI_PROVIDER=deepseek explicitly to use this adapter; key stays server-side.
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=replace_with_deepseek_api_key
# Online requires the exact canonical HTTPS origin, with no trailing slash.
# APP_ORIGIN=https://your-project.vercel.app
FREELLMAPI_BASE_URL=http://127.0.0.1:31415/v1
FREELLMAPI_MODEL=auto
FREELLMAPI_API_KEY=replace_with_local_unified_key
SUPABASE_URL=https://replace_project_ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
AUTH_SITE_URL=http://127.0.0.1:3000
AUTH_GOOGLE_ENABLED=false
# Email login for existing accounts; Supabase Email provider must be enabled.
AUTH_EMAIL_ENABLED=true
