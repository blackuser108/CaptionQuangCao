# Server only. Root npm scripts load root .env.local; workspace commands read prototype/.env.local.
# Keep actual keys in one ignored file; never commit them or duplicate them unnecessarily.
AI_PROVIDER=groq
# Smart uses the reference V3 Writer and Judge, with at most one availability fallback.
# Single remains an explicit one-pass option.
# Deep remains an explicit server option with at most four total attempts.
CAPTION_PIPELINE=smart
# V3 supports a separate Judge provider; this keeps Groq free-tier token use bounded.
CAPTION_JUDGE_PROVIDER=cloudflare
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=replace_with_groq_api_key
CLOUDFLARE_ACCOUNT_ID=replace_with_cloudflare_account_id
CLOUDFLARE_API_TOKEN=replace_with_cloudflare_workers_ai_token
# Optional. The server defaults to this model.
# CLOUDFLARE_AI_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
# Set AI_PROVIDER=deepseek explicitly to use this adapter; key stays server-side.
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=replace_with_deepseek_api_key
# Online requires the exact canonical HTTPS origin, with no trailing slash.
# APP_ORIGIN=https://your-project.vercel.app
FREELLMAPI_BASE_URL=http://127.0.0.1:31415/v1
FREELLMAPI_MODEL=auto
FREELLMAPI_API_KEY=replace_with_local_unified_key
SUPABASE_URL=https://replace_project_ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
AUTH_SITE_URL=http://127.0.0.1:3000
AUTH_GOOGLE_ENABLED=false
# Email login for existing accounts; Supabase Email provider must be enabled.
AUTH_EMAIL_ENABLED=true
