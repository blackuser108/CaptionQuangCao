# Server only. Next.js reads prototype/.env.local; never commit actual keys.
# deepseek | gemini | freellmapi. Caption logic is shared; only the HTTP adapter changes.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=replace_with_deepseek_api_key
# Official models at implementation time: deepseek-flash (default) or deepseek-v4-pro.
# See https://api-docs.deepseek.com/ — not a free forever plan.
DEEPSEEK_MODEL=deepseek-flash
# Gemini is used when AI_PROVIDER=gemini, or as fallback if DeepSeek fails and this key exists.
GEMINI_MODEL=auto
GEMINI_API_KEY=replace_with_gemini_developer_api_key
# Online requires the exact canonical HTTPS origin, with no trailing slash.
# APP_ORIGIN=https://your-project.vercel.app
FREELLMAPI_BASE_URL=http://127.0.0.1:31415/v1
FREELLMAPI_MODEL=auto
FREELLMAPI_API_KEY=replace_with_local_unified_key
SUPABASE_URL=https://replace_project_ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
AUTH_SITE_URL=http://127.0.0.1:3000
AUTH_GOOGLE_ENABLED=false
# Chế độ sinh caption (server-only):
#   single (mặc định) 1 lần gọi AI | smart 2 lần: viết nhiều ứng viên + biên tập viên chấm
#   deep   ~4 lần: thêm lượt chấm đảo thứ tự (chạy song song) + chỉnh câu. = dùng TẤT CẢ agent.
# Bước agent nào lỗi thì dùng kết quả tốt nhất đã có, hoặc về đường single. Mỗi lượt Tạo/Tạo lại tốn nhiều request hơn: để ý quota.
CAPTION_PIPELINE=deep
# Tùy chọn: cho Judge chạy trên nhà cung cấp KHÁC Writer (deepseek | gemini | freellmapi) để bớt thiên vị văn của chính model.
# Cần có khóa hợp lệ của nhà cung cấp đó; nếu không hợp lệ hoặc trùng nhà cung cấp chính thì bị bỏ qua.
# CAPTION_JUDGE_PROVIDER=deepseek
